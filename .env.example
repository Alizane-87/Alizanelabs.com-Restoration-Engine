# Absolute public origin used for canonicals, sitemap, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="https://alizanelabs.com"

# Optional. External scheduling URL. When unset, every CTA routes to /dispatch-audit.
# NEXT_PUBLIC_SCHEDULING_URL=""

# Optional. Public demo line in E.164 format. Only rendered once a tested number exists.
# NEXT_PUBLIC_DEMO_PHONE="+15551234567"

# Server-side only. Destination that receives qualified dispatch-audit leads.
# Required in production: without it the API refuses to accept leads rather than losing them.
# LEAD_WEBHOOK_URL=""

# Optional. Sent as "Authorization: Bearer <token>" with the lead webhook request.
# LEAD_WEBHOOK_TOKEN=""

# Optional. Mailbox passed to the lead destination for notification routing.
# LEAD_NOTIFY_EMAIL=""
