# ---- Required ----
# Shared secret GHL signs webhook bodies with (HMAC-SHA256, hex or base64 digest).
GHL_WEBHOOK_SECRET=
# Bearer token the CEO's approve button must present.
APPROVAL_API_TOKEN=
# LLM extraction
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# ---- Staging sinks (configure at least one) ----
# Google Sheets service account with edit access to the staging spreadsheet.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Onboarding Staging
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n escapes, or base64-encode the whole key.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Slack incoming webhook used to notify the CEO that a record needs review.
SLACK_WEBHOOK_URL=

# ---- Optional ----
# Public base URL, used to build the review/approve links in notifications.
APP_BASE_URL=https://provisioning.alizanelabs.site
# Upstash Redis REST credentials enable cross-instance idempotency and rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Max webhook body size in bytes (default 1000000).
MAX_WEBHOOK_BODY_BYTES=1000000
